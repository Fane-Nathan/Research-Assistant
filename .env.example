# Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# Google Gemini API Key (Required for embeddings and LLM)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (Optional - for alternative LLM provider)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API Key (Optional - for alternative LLM provider)
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Hugging Face API Token (Optional - for Hugging Face models)
# Get your token from: https://huggingface.co/settings/tokens
# HF_API_TOKEN=your_huggingface_token_here

# OpenAI API Key (Optional - for OpenAI models)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
